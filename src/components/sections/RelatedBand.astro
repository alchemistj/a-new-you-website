---
// Related services band (Rule 4.3): its own full-width tinted band, before the FAQ.
// Links only to published pages (the caller resolves slugs).
interface Props {
  items: { label: string; href: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="band band-related" id="related" aria-labelledby="related-h">
      <div class="container">
        <h2 id="related-h">Related Services</h2>
        <div class="cards">
          {items.map((i) => <a class="card card-link" href={i.href}>{i.label}</a>)}
        </div>
      </div>
    </section>
  )
}
