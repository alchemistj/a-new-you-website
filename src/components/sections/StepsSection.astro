---
import Split from './Split.astro';
import { rich } from '../../lib/rich';
import type { ImageRef } from '../../types/page';

interface Props {
  id?: string;
  heading?: string;
  intro?: string;
  steps: { title: string; text?: string }[];
  image?: ImageRef;
  side?: 'left' | 'right';
}
const { id, heading, intro, steps, image, side } = Astro.props;
---

<section class="section" id={id}>
  <div class="container">
    <Split image={image} side={side}>
      {heading && <h2>{heading}</h2>}
      {intro && <p class="intro" set:html={rich(intro)} />}
      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <h3>{s.title}</h3>
              {s.text && <p set:html={rich(s.text)} />}
            </li>
          ))
        }
      </ol>
    </Split>
  </div>
</section>
