---
// Cards are for short, scannable items only (Rule 4.1): a title and at most a sentence or two.
import { rich } from '../../lib/rich';

interface Props {
  id?: string;
  heading?: string;
  intro?: string;
  cards: { title: string; text?: string; href?: string }[];
}
const { id, heading, intro, cards } = Astro.props;
---

<section class="section" id={id}>
  <div class="container">
    {heading && <h2>{heading}</h2>}
    {intro && <p class="intro" set:html={rich(intro)} />}
    <div class="cards">
      {
        cards.map((c) => (
          <div class="card">
            <h3>{c.href ? <a href={c.href}>{c.title}</a> : c.title}</h3>
            {c.text && <p set:html={rich(c.text)} />}
          </div>
        ))
      }
    </div>
  </div>
</section>
