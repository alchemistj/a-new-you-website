---
// Trust bar directly under the hero (Rule 9). Credentials come from the brief only; no star
// ratings, review counts or unconfirmed claims. Second line: serving area, CTA, click-to-call.
import { site, cityConfig } from '../data/site';

const area = cityConfig.serviceArea;
const areaText = `${area.slice(0, -1).join(', ')} & ${area[area.length - 1]}`;
---

<section class="trust-bar" aria-label="About the clinic">
  <div class="container">
    <ul class="trust-items">
      <li>{site.founder.name}</li>
      <li>{site.founder.yearsHealthcare} years in healthcare</li>
      <li>{site.founder.yearsWomensHealth} years in women's health</li>
    </ul>
    <p class="trust-line">
      <span>Serving {areaText}</span>
      <a href={site.booking.href} target="_blank" rel="noopener">{site.booking.label}</a>
      <a class="trust-phone" href={site.phone.tel}>
        Call {site.founder.shortName}<span class="hidden md:inline">: {site.phone.display}</span>
      </a>
    </p>
  </div>
</section>
