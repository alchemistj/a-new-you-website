---
// Footer (brief): every published service page, plus Biote, Memberships, Financing, Customer Reviews,
// About, FAQ, Blog, Contact. Address, phone (digits, also on mobile: Rule 7.2), email, socials, BBB.
import { getNav } from '../lib/nav';
import { site, fullAddress } from '../data/site';

const nav = await getNav();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col">
      <p class="footer-title">{site.name}</p>
      <address>
        {site.address.street}<br />
        {site.address.city}, {site.address.region} {site.address.postalCode}
      </address>
      <p><a href={site.phone.tel}>{site.phone.display}</a></p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p class="footer-social">
        <a href={site.social.instagram} rel="noopener" target="_blank">Instagram</a>
        <a href={site.social.facebook} rel="noopener" target="_blank">Facebook</a>
        <a href={site.social.bbb} rel="noopener" target="_blank">BBB Profile</a>
      </p>
    </div>
    {
      nav.footerServices.length > 0 && (
        <nav class="footer-col" aria-label="Services">
          <p class="footer-title">Services</p>
          <ul>{nav.footerServices.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      )
    }
    <nav class="footer-col" aria-label="Company">
      <p class="footer-title">Company</p>
      <ul>{nav.footerCompany.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
  </div>
  <div class="container footer-base">
    <p>&copy; {year} {site.name}. {fullAddress}</p>
  </div>
</footer>
