---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleJsonLd } from '../../lib/seo/jsonld';
import { absoluteUrl } from '../../lib/seo/nap';
import { blogPath, dateFormat, getPosts, loadImage, relatedService } from '../blog/_blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { post: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const path = blogPath(post.id);
const hero = await loadImage(data.heroImage?.src);
const heroOg = hero ? await getImage({ src: hero, width: 1200 }) : undefined;
const service = relatedService(data.relatedService);
const published = data.pubDate.toISOString().slice(0, 10);
const updated = data.updatedDate && data.updatedDate > data.pubDate ? data.updatedDate : undefined;

const jsonLd = [
  articleJsonLd({
    title: data.title,
    description: data.description,
    path,
    datePublished: data.pubDate,
    dateModified: data.updatedDate,
    image: heroOg?.src,
    authorName: data.author,
  }),
  // Posts live at the root, so breadcrumbJsonLd (which only adds Blog under /blog/) is not used.
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: absoluteUrl('/blog/') },
      { '@type': 'ListItem', position: 3, name: data.title, item: absoluteUrl(path) },
    ],
  },
];
---

<BaseLayout title={data.title} description={data.description} path={path} jsonLd={jsonLd}>
  <article class="post mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
    <header>
      <h1 class="text-3xl font-bold leading-tight sm:text-4xl">{data.title}</h1>
      <p class="mt-3 text-sm opacity-80">
        By {data.author} &middot; <time datetime={published}>{dateFormat.format(data.pubDate)}</time>
        {
          updated && (
            <>
              &middot; Updated <time datetime={updated.toISOString().slice(0, 10)}>{dateFormat.format(updated)}</time>
            </>
          )
        }
      </p>
    </header>

    {
      hero && (
        <Image
          src={hero}
          alt={data.heroImage?.alt ?? ''}
          width={1200}
          widths={[480, 768, 1200]}
          sizes="(min-width: 768px) 768px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="mt-6 h-auto w-full"
        />
      )
    }

    <div class="post-body mt-8">
      <Content />
    </div>

    {
      service && (
        <p class="mt-10">
          Related service: <a href={service.href} class="font-semibold underline">{service.label}</a>
        </p>
      )
    }

    <p class="mt-8">
      <a href="/blog/" class="font-semibold underline">&larr; Back to the blog</a>
    </p>
  </article>
</BaseLayout>

<style is:global>
  .post-body > * + * {
    margin-top: 1.1em;
  }
  .post-body h2 {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    margin-top: 2em;
  }
  .post-body h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-top: 1.6em;
  }
  .post-body h4,
  .post-body h5,
  .post-body h6 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-top: 1.4em;
  }
  .post-body ul,
  .post-body ol {
    padding-left: 1.4em;
  }
  .post-body ul {
    list-style: disc;
  }
  .post-body ol {
    list-style: decimal;
  }
  .post-body li + li {
    margin-top: 0.4em;
  }
  .post-body a {
    text-decoration: underline;
  }
  .post-body img {
    height: auto;
    max-width: 100%;
  }
  .post-body blockquote {
    border-left: 4px solid currentColor;
    padding-left: 1em;
    opacity: 0.9;
  }
  .post-body hr {
    margin-block: 2em;
    opacity: 0.3;
  }
  .post-body table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
  .post-body th,
  .post-body td {
    border: 1px solid rgb(0 0 0 / 0.2);
    padding: 0.4em 0.7em;
  }
</style>
