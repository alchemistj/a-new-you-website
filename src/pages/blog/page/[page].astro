---
// /blog/page/2/, /blog/page/3/, ... (page 1 is /blog/).
import BlogList from '../_BlogList.astro';
import { POSTS_PER_PAGE, getPosts } from '../_blog';

export async function getStaticPaths() {
  const total = Math.ceil((await getPosts()).length / POSTS_PER_PAGE);
  return Array.from({ length: Math.max(total - 1, 0) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2 },
  }));
}

const { page } = Astro.props;
---

<BlogList page={page} />
